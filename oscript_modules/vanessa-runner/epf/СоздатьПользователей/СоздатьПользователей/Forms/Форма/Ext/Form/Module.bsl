////////////////////////////////////////////////////////////////////////////////
// Обработка создания пользователей информационной базы.
// Построена по шаблону epf/ШаблонОбработки: регион "Инфраструктура" и обработчики
// формы общие (эталон - ШаблонОбработки), уникальна только "БизнесЛогика".
//
// Режим (по флагам параметров запуска):
//   - СоздатьАдминистратора / AdminCreate: создать первого администратора
//     (Имя, Роли - список ролей через запятую; по умолчанию ПолныеПрава, АдминистраторСистемы).
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем ПутьКОбработке; // каталог обработки (для разрешения путей вида $instrumentsRoot)

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УбратьПодтверждениеПриЗавершенииПрограммы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтрокаЗапуска = СокрЛП(ПараметрЗапуска);
	Если СтрокаЗапуска = "" Тогда
		Возврат;
	КонецЕсли;

	ПутьФайлаРезультата = "";
	Результат = НовыйРезультат();
	ЗавершитьРаботуСистемыЗапрошено = Ложь;

	Попытка
		ПутьКОбработке = ПолучитьПутьОбработки();

		ПараметрыЗапуска = ПолучитьСтруктуруПараметров(СтрокаЗапуска);
		ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(ПараметрыЗапуска);

		Если ПараметрыЗапуска.Свойство("ФайлРезультата") Тогда
			ПутьФайлаРезультата = ПараметрыЗапуска.ФайлРезультата;
		КонецЕсли;
		ЗавершитьРаботуСистемыЗапрошено = ПараметрыЗапуска.Свойство("ЗавершитьРаботуСистемы");

		Результат = ВыполнитьОперацию(ПараметрыЗапуска);
	Исключение
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Неудача при выполнении обработки: " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗаписатьФайлРезультата(ПутьФайлаРезультата, Результат);

	Если ЗавершитьРаботуСистемыЗапрошено Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	Иначе
		ПрекратитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область БизнесЛогика

&НаКлиенте
Функция ВыполнитьОперацию(Знач ПараметрыЗапуска)

	Результат = НовыйРезультат();

	Если ПараметрыЗапуска.Свойство("СоздатьАдминистратора") ИЛИ ПараметрыЗапуска.Свойство("AdminCreate") Тогда
		Имя = "";
		ПараметрыЗапуска.Свойство("Имя", Имя);
		ИменаРолей = "";
		ПараметрыЗапуска.Свойство("Роли", ИменаРолей);

		ДобавитьСообщения(Результат.Сообщения, СоздатьПервогоАдминистратораПриНеобходимости(Имя, ИменаРолей));
	Иначе
		Результат.Сообщения.Добавить("Не указан режим создания пользователя (СоздатьАдминистратора)");
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьПервогоАдминистратораПриНеобходимости(Знач Имя, Знач ИменаРолей = "")

	Сообщения = Новый Массив;

	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() > 0 Тогда
		Текст = "Уже существуют пользователи. Пользователь не создан!";
		Лог(Текст);
		Сообщения.Добавить(Текст);
		Возврат Сообщения;
	КонецЕсли;

	Администратор = ПользователиИнформационнойБазы.СоздатьПользователя();
	Администратор.Имя = Имя;
	Администратор.АутентификацияСтандартная = Истина;
	Администратор.ПоказыватьВСпискеВыбора = Истина;
	Администратор.ПолноеИмя = Имя;

	СнятьЗащитуОтОпасныхДействий(Администратор);

	// Если роли заданы явно (ключ Роли) - назначаем именно их и не навязываем
	// административные роли. Иначе используем набор по умолчанию администратора.
	РолиЗаданыЯвно = НЕ ПустаяСтрока(СокрЛП(ИменаРолей));
	Если РолиЗаданыЯвно Тогда
		МассивИменРолей = СтрРазделить(ИменаРолей, ",");
	Иначе
		МассивИменРолей = Новый Массив;
		МассивИменРолей.Добавить("ПолныеПрава");
		МассивИменРолей.Добавить("АдминистраторСистемы");
	КонецЕсли;

	КоличествоНазначенныхРолей = 0;
	Для Каждого ИмяРоли Из МассивИменРолей Цикл
		ИмяРоли = СокрЛП(ИмяРоли);
		Если ПустаяСтрока(ИмяРоли) Тогда
			Продолжить;
		КонецЕсли;
		Если ДобавитьРольПользователю(Администратор, ИмяРоли) Тогда
			КоличествоНазначенныхРолей = КоличествоНазначенныхРолей + 1;
		Иначе
			Лог("Роль не найдена в конфигурации и пропущена: " + ИмяРоли, "Предупреждение");
		КонецЕсли;
	КонецЦикла;

	Если НЕ РолиЗаданыЯвно Тогда
		// Для администратора по умолчанию добавляем роль открытия внешних обработок (если есть).
		ДобавитьРольПользователю(Администратор, "ИнтерактивноеОткрытиеВнешнихОтчетовИОбработок");
	КонецЕсли;

	// Ни одна из запрошенных ролей не найдена в конфигурации. Создавать пользователя
	// бессмысленно: платформа запретит запись (нельзя оставить ИБ без администратора)
	// либо пользователь будет без прав. Даём понятную ошибку вместо системной.
	Если КоличествоНазначенныхРолей = 0 Тогда
		ВызватьИсключение СтрЗаменить(
			"Ни одна из указанных ролей не найдена в конфигурации: %1."
			+ " Невозможно создать пользователя: платформа запрещает оставлять"
			+ " информационную базу без пользователя с административными правами."
			+ " Загрузите конфигурацию, содержащую нужные роли"
			+ " (например, ПолныеПрава), перед созданием пользователя.",
			"%1", СтрСоединить(МассивИменРолей, ", "));
	КонецЕсли;

	Попытка
		Администратор.Язык = Метаданные.Языки.Русский;
	Исключение
		// В конфигурации может не быть русского языка - не критично.
		Лог("Не удалось установить язык пользователя: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Администратор.Записать();
	Исключение
		ВызватьИсключение СтрЗаменить(СтрЗаменить(
			"Не удалось создать пользователя '%1'. %2"
			+ " Если это первый пользователь базы, среди назначенных ролей должна"
			+ " быть роль с правом администрирования (например, ПолныеПрава).",
			"%1", Имя), "%2", ОписаниеОшибки());
	КонецПопытки;

	Сообщение = СтрЗаменить("Пользователь с именем %1 создан!", "%1", Имя);
	Лог(Сообщение, "");
	Сообщения.Добавить(Сообщение);

	Возврат Сообщения;

КонецФункции

&НаСервереБезКонтекста
Процедура СнятьЗащитуОтОпасныхДействий(ПользовательИБ)

	Попытка
		ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
		ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
		ПользовательИБ.ЗащитаОтОпасныхДействий = ОписаниеЗащиты;
	Исключение
		Лог("Не удалось снять защиту от опасных действий пользователю");
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДобавитьРольПользователю(ПользовательИБ, Знач ИмяРоли)

	Если Метаданные.Роли.Найти(ИмяРоли) <> Неопределено Тогда
		ПользовательИБ.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Логирование хода создания пользователя в журнал регистрации и окно сообщений.
// Никогда не бросает исключение: на только что созданной базе журнал/сообщения
// могут быть недоступны, и это не должно прерывать запись результата.
&НаСервереБезКонтекста
Процедура Лог(Знач Комментарий, Знач Уровень = "Ошибка")

	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Уровень = "Информация";
	КонецЕсли;

	УровеньЖР = УровеньЖурналаРегистрации.Информация;
	Если НРег(Уровень) = "ошибка" Тогда
		УровеньЖР = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли НРег(Уровень) = "предупреждение" Тогда
		УровеньЖР = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	Попытка
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = Уровень + ": " + Комментарий;
		СообщениеПользователю.Сообщить();
	Исключение
		// намеренно подавлено
	КонецПопытки;

	Попытка
		ЗаписьЖурналаРегистрации(КлючЖР(), УровеньЖР, Неопределено, Неопределено, Комментарий);
	Исключение
		// намеренно подавлено
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючЖР()
	Возврат "VanessaRunner.СозданиеПользователей";
КонецФункции

#КонецОбласти

#Область Инфраструктура

// Общий код по конвенции (эталон - epf/ШаблонОбработки). Не редактируется в конкретной обработке.

// --- Результат ---

&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультат()
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка", 0, Новый Массив, "");
КонецФункции

&НаКлиенте
Процедура ДобавитьСообщения(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСообщенияСервер(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФайлРезультата(Знач ПутьФайла, Знач Результат)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = Новый Структура;
		Данные.Вставить("КодВозврата", Результат.КодВозврата);
		Данные.Вставить("Сообщения", Результат.Сообщения);
		Данные.Вставить("Ошибка", Результат.Ошибка);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ПутьФайла, "UTF-8");
		ЗаписатьJSON(ЗаписьJSON, Данные);
		ЗаписьJSON.Закрыть();
	Исключение
		// Сбой записи файла результата не должен прерывать завершение работы обработки.
	КонецПопытки;

КонецПроцедуры

// --- Разбор параметров строки запуска ---

&НаКлиенте
Функция ПолучитьСтруктуруПараметров(Стр)

	Результат = Новый Структура;

	Массив = РазложитьСтрокуВМассивПодстрок(Стр, ";");
	Для каждого Элем Из Массив Цикл
		Поз = Найти(Элем, "=");
		Если Поз > 0 Тогда
			Ключ     = Лев(Элем, Поз - 1);
			Значение = Сред(Элем, Поз + 1);
			Попытка
				Результат.Вставить(СокрЛП(Ключ), СокрЛП(Значение));
			Исключение
				// некорректный ключ - пропускаем
			КонецПопытки;
		Иначе
			Если НЕ ПустаяСтрока(Элем) Тогда
				Попытка
					Результат.Вставить(СокрЛП(Элем), Истина);
				Исключение
					// некорректный флаг - пропускаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",",
		Знач ПропускатьПустыеСтроки = Неопределено)

	Результат = Новый Массив;

	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;

	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(СтруктураПараметров)

	МассивКлючей = Новый Массив;
	Для каждого ПараметрБилда Из СтруктураПараметров Цикл
		Если Лев(ПараметрБилда.Значение, 1) = "." Или Найти(ПараметрБилда.Значение, "$instrumentsRoot") > 0 Тогда
			МассивКлючей.Добавить(ПараметрБилда.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для каждого Ключ Из МассивКлючей Цикл
		Стало = ПреобразоватьПутьСТочкамиКНормальномуПути(СтруктураПараметров[Ключ]);
		Стало = ЗаменитьСлеши(Стало);
		СтруктураПараметров.Вставить(Ключ, Стало);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьПутьСТочкамиКНормальномуПути(ОригСтр)

	Если Найти(ОригСтр, "$instrumentsRoot") > 0 И НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		Возврат СтрЗаменить(ОригСтр, "$instrumentsRoot", ДополнитьСлешВПуть(ПутьКОбработке));
	КонецЕсли;

	Возврат ОригСтр;

КонецФункции

&НаКлиенте
Функция ДополнитьСлешВПуть(Знач Каталог)

	Разделитель = ПолучитьРазделительПути();
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;
	Если Прав(Каталог, 1) <> Разделитель Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;
	Возврат Каталог;

КонецФункции

&НаКлиенте
Функция ЗаменитьСлеши(Знач Путь)
	Результат = СтрЗаменить(Путь, "\", ПолучитьРазделительПути());
	Результат = СтрЗаменить(Результат, "/", ПолучитьРазделительПути());
	Возврат Результат;
КонецФункции

// --- Путь к обработке ---

&НаКлиенте
Функция ПолучитьПутьОбработки()

	Перем ФайлПути, Результат;

	Результат = ПолучитьПутьКОбработкеСервер();
	Если НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		ФайлПути = Новый Файл(ПутьКОбработке);
		Результат = ФайлПути.Путь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьПутьКОбработкеСервер()

	ОбъектНаСервере = ОбъектНаСервере();
	ИспользуемоеИмяФайла = ОбъектНаСервере.ИспользуемоеИмяФайла;
	ПрефиксИмени = НРег(Лев(ИспользуемоеИмяФайла, 6));
	Если (ПрефиксИмени <> "e1cib/") И (ПрефиксИмени <> "e1cib\") Тогда
		Возврат ИспользуемоеИмяФайла;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция ОбъектНаСервере()
	Возврат РеквизитФормыВЗначение("Объект");
КонецФункции

// --- Завершение работы ---

&НаСервере
Процедура УбратьПодтверждениеПриЗавершенииПрограммы()

	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") <> Неопределено Тогда
		МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
		Попытка
			МодульОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбщиеНастройкиПользователя",
				"ЗапрашиватьПодтверждениеПриЗавершенииПрограммы", Ложь);
		Исключение
			// Данного модуля и метода может не быть в конфигурации
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
